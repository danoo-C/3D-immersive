{
  "author": "3d immersive",
  "channels": [
    "#A855F7",
    "#22D3EE",
    "#F59E0B",
    "#34D399",
    "#F472B6",
    "#60A5FA",
    "#FB923C",
    "#A3E635"
  ],
  "groups": {
    "button": {
      "background": "surface.hover",
      "border": "border",
      "checked.background": "accent.pressed",
      "checked.border": "accent",
      "disabled.border": "surface.hover",
      "disabled.text": "text.disabled",
      "hover.border": "accent.text",
      "pressed.background": "accent.pressed",
      "text": "text.primary"
    },
    "channel": {
      "background": "surface.raised",
      "border": "border",
      "bypass.background": "text.secondary",
      "bypass.text": "surface.window",
      "mute.background": "warn",
      "mute.text": "surface.window",
      "name": "text.primary",
      "quiet": "text.disabled",
      "solo.background": "accent.text",
      "solo.text": "surface.window"
    },
    "filter": {
      "background": "surface.window",
      "border": "border",
      "focus.border": "accent",
      "text": "text.primary"
    },
    "focus": {
      "menu.background": "surface.hover",
      "ring": "accent"
    },
    "header": {
      "background": "surface.raised",
      "border": "border",
      "text": "text.secondary"
    },
    "input": {
      "background": "surface.window",
      "border": "border",
      "focus.border": "accent",
      "text": "text.primary"
    },
    "menu": {
      "background": "surface.raised",
      "bar.background": "surface.raised",
      "bar.border": "border",
      "bar.selected.background": "surface.hover",
      "border": "border",
      "disabled.text": "text.disabled",
      "selected.background": "accent.pressed",
      "selected.text": "text.primary",
      "separator": "border"
    },
    "panel": {
      "background": "surface.panel",
      "text": "text.primary"
    },
    "ruler": {
      "background": "surface.raised",
      "text": "text.secondary",
      "tick": "text.disabled"
    },
    "scrollbar": {
      "background": "surface.panel",
      "handle": "surface.hover",
      "hover.handle": "accent.pressed"
    },
    "splitter": {
      "handle": "border",
      "hover.handle": "accent"
    },
    "statusbar": {
      "background": "surface.raised",
      "border": "border",
      "text": "text.secondary"
    },
    "tab": {
      "background": "surface.window",
      "bar.background": "surface.window",
      "hover.background": "surface.raised",
      "hover.text": "text.primary",
      "pane.background": "surface.panel",
      "selected.background": "surface.panel",
      "selected.marker": "accent",
      "selected.text": "text.primary",
      "text": "text.secondary"
    },
    "timeline": {
      "background": "surface.panel",
      "grid": "border",
      "grid.beat": "surface.hover",
      "grid.division": "surface.raised",
      "playhead": "accent",
      "separator": "border"
    },
    "toolbar": {
      "background": "surface.raised",
      "border": "border",
      "separator": "border"
    },
    "tooltip": {
      "background": "surface.raised",
      "border": "accent.pressed",
      "text": "text.primary"
    },
    "tree": {
      "background": "surface.panel",
      "hover.background": "surface.raised",
      "selected.background": "surface.hover",
      "selected.text": "text.primary",
      "text": "text.primary"
    },
    "waveform": {
      "background": "surface.panel",
      "centre": "border",
      "fill": "text.secondary",
      "missing": "warn"
    },
    "window": {
      "background": "surface.window"
    }
  },
  "name": "VS Code Dark",
  "schema_version": 1,
  "tokens": {
    "accent": "#A855F7",
    "accent.pressed": "#7E3FF2",
    "accent.text": "#C77DFF",
    "border": "#3C3C3C",
    "error": "#F88A8A",
    "surface.hover": "#2D2D2D",
    "surface.panel": "#1F1F1F",
    "surface.raised": "#252526",
    "surface.window": "#181818",
    "text.disabled": "#6E6E6E",
    "text.primary": "#CCCCCC",
    "text.secondary": "#9D9D9D",
    "warn": "#F59E0B"
  }
}
