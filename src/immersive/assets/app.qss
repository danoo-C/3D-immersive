
/* One stack, resolved per platform by Qt: Segoe UI on Windows, SF on macOS,
   Ubuntu or Noto on Linux. Naming a single family gets a fallback nobody
   chose on the two platforms that do not have it. */
QWidget {
    background-color: $panel_background;
    color: $panel_text;
    font-family: "Segoe UI", "SF Pro Text", "Inter", "Ubuntu", "Noto Sans",
                 "DejaVu Sans", sans-serif;
    font-size: 13px;
}

QMainWindow, QMainWindow > QWidget { background-color: $window_background; }

QMenuBar {
    background-color: $menu_bar_background;
    border-bottom: 1px solid $menu_bar_border;
    padding: 2px 4px;
}
QMenuBar::item { padding: 5px 10px; border-radius: 4px; }
QMenuBar::item:selected { background-color: $menu_bar_selected_background; }

QMenu {
    background-color: $menu_background;
    border: 1px solid $menu_border;
    padding: 4px;
}
QMenu::item { padding: 6px 24px 6px 20px; border-radius: 4px; }
QMenu::item:selected { background-color: $menu_selected_background; color: $menu_selected_text; }
QMenu::item:disabled { color: $menu_disabled_text; }
QMenu::separator { height: 1px; background: $menu_separator; margin: 4px 8px; }

QToolBar {
    background-color: $toolbar_background;
    border-bottom: 1px solid $toolbar_border;
    padding: 4px 6px;
    spacing: 4px;
}
QToolBar::separator { width: 1px; background: $toolbar_separator; margin: 4px 6px; }

QToolButton, QPushButton {
    background-color: $button_background;
    border: 1px solid $button_border;
    border-radius: 5px;
    padding: 5px 10px;
    color: $button_text;
}
QToolButton:hover, QPushButton:hover { border-color: $button_hover_border; }
QToolButton:pressed, QPushButton:pressed { background-color: $button_pressed_background; }
QToolButton:checked {
    background-color: $button_checked_background;
    border-color: $button_checked_border;
}
QToolButton:disabled, QPushButton:disabled {
    color: $button_disabled_text;
    border-color: $button_disabled_border;
}

/* Tabs are flat and marked by an accent rule on the selected one, rather than
   drawn as raised folders - the workspace has two tabs (D-49), and chrome
   heavy enough to notice would be chrome competing with the scene. */
QTabWidget::pane { border: none; background: $tab_pane_background; }
QTabBar { background: $tab_bar_background; }
QTabBar::tab {
    background: $tab_background;
    color: $tab_text;
    border: none;
    border-top: 2px solid transparent;
    padding: 7px 18px 8px 18px;
}
QTabBar::tab:hover:!selected { background: $tab_hover_background; color: $tab_hover_text; }
QTabBar::tab:selected {
    background: $tab_selected_background;
    color: $tab_selected_text;
    border-top: 2px solid $tab_selected_marker;
}

/* 04-ui-spec.md lists the focus ring among the accent's jobs. Without a rule
   here it falls back to whatever Fusion draws, which is neither purple nor
   consistent between platforms - and "no information by colour alone" cuts
   both ways: a focus indicator nobody can see fails keyboard users first.

   The tab bar is deliberately left out: its selected tab already carries an
   accent rule, and a box around it on focus puts two indicators on one widget
   and undoes the flatness the block above is for. */
*:focus { outline: none; }
QToolButton:focus, QPushButton:focus { border: 1px solid $focus_ring; }
QMenuBar::item:focus { background-color: $focus_menu_background; }

QSplitter::handle { background-color: $splitter_handle; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QSplitter::handle:hover { background-color: $splitter_hover_handle; }

QStatusBar {
    background-color: $statusbar_background;
    border-top: 1px solid $statusbar_border;
    color: $statusbar_text;
}
QStatusBar::item { border: none; }

QLabel { background: transparent; }

QScrollBar:vertical, QScrollBar:horizontal {
    background: $scrollbar_background;
    border: none;
}
QScrollBar:vertical { width: 10px; }
QScrollBar:horizontal { height: 10px; }
QScrollBar::handle { background: $scrollbar_handle; border-radius: 5px; min-height: 24px; }
QScrollBar::handle:hover { background: $scrollbar_hover_handle; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QToolTip {
    background-color: $tooltip_background;
    color: $tooltip_text;
    border: 1px solid $tooltip_border;
    padding: 4px 6px;
}

/* The media pool (M2): its tree, the tree's header, and its filter. The
   filter is styled by its object name, because a generic QLineEdit is the
   "input field" group 04 leaves to M8. */
QTreeView {
    background-color: $tree_background;
    color: $tree_text;
    border: none;
    outline: none;
}
QTreeView::item { padding: 1px 0; }
QTreeView::item:hover { background-color: $tree_hover_background; }
QTreeView::item:selected {
    background-color: $tree_selected_background;
    color: $tree_selected_text;
}
QHeaderView::section {
    background-color: $header_background;
    color: $header_text;
    border: none;
    border-bottom: 1px solid $header_border;
    padding: 3px 6px;
}
QLineEdit#PoolFilter {
    background-color: $filter_background;
    color: $filter_text;
    border: 1px solid $filter_border;
    border-radius: 4px;
    padding: 3px 6px;
    margin: 6px;
}
QLineEdit#PoolFilter:focus { border-color: $filter_focus_border; }

/* Typed input (M3): the numeric field, dragged or typed, first used for a
   channel's gain. 04 listed the input-field group under M8, for whichever
   milestone first drew one; this is it. */
QLineEdit#NumericField, QLineEdit#ChannelRename {
    background-color: $input_background;
    color: $input_text;
    border: 1px solid $input_border;
    border-radius: 3px;
    padding: 1px 4px;
}
QLineEdit#NumericField:focus, QLineEdit#ChannelRename:focus {
    border-color: $input_focus_border;
}
QLineEdit#NumericField:disabled { color: $input_disabled_text; }

/* The parameters pane (M3): a view's heading, and its fields' labels, which
   support the fields rather than compete with them. */
QLabel#PaneHeading { color: $pane_heading; font-weight: 600; }
QLabel#FieldLabel { color: $pane_label; }

/* Combo boxes (M3): the parameters pane is the first to draw one. 04 listed
   them under M8, for whichever milestone drew one first. The arrow is the
   style's own. The check box paints itself, from the painted `check` group:
   a sheet that styles its indicator loses the tick. */
QComboBox {
    background-color: $combo_background;
    color: $combo_text;
    border: 1px solid $combo_border;
    border-radius: 3px;
    padding: 1px 6px;
}
QComboBox:focus { border-color: $combo_focus_border; }
QComboBox:disabled { color: $combo_disabled_text; }
QComboBox QAbstractItemView {
    background-color: $combo_list_background;
    color: $combo_list_text;
    border: 1px solid $combo_list_border;
    selection-background-color: $combo_list_selected_background;
}

/* Channel headers (M3). Every "on" carries a letter as well as a colour, and
   a channel silenced by another's solo says so in words (04, Accessibility
   and feel). The chip is the channel's own colour and painted, not here. */
QFrame#ChannelHeader {
    background-color: $channel_background;
    border-bottom: 1px solid $channel_border;
    border-left: 3px solid transparent;
}
QFrame#ChannelHeader[selected="true"] {
    background-color: $channel_selected_background;
    border-left-color: $channel_selected_marker;
}
QLabel#ChannelName, QToolButton#ChannelSnap[overriding="true"] { color: $channel_name; }
QLabel#ChannelQuiet, QToolButton#ChannelSnap[overriding="false"] {
    color: $channel_quiet;
    font-size: 11px;
}
QFrame#ChannelHeader QToolButton { padding: 1px 6px; }
/* The snap indicator reads as text in the header, and is a button only to
   the pointer and the keyboard: no frame, no arrow, its focus ring kept. */
QFrame#ChannelHeader QToolButton#ChannelSnap { background: transparent; padding: 0 2px; }
QFrame#ChannelHeader QToolButton#ChannelSnap:!focus { border: 1px solid transparent; }
QToolButton#ChannelSnap::menu-indicator { image: none; width: 0; }
QToolButton#AddChannel { border-radius: 0; border-width: 0 0 1px 0; padding: 0 8px; }
QToolButton#Mute:checked {
    background-color: $channel_mute_background;
    color: $channel_mute_text;
}
QToolButton#Solo:checked {
    background-color: $channel_solo_background;
    color: $channel_solo_text;
}
QToolButton#Bypass:checked {
    background-color: $channel_bypass_background;
    color: $channel_bypass_text;
}
